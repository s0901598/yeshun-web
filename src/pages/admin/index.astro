---
// 後台頁面：整頁由 Preact 在瀏覽器裡執行，登入後才讀寫資料庫
import '../../styles/global.css';
import '../../admin/admin.css';
import App from '../../admin/App';
import { darkModeEnabled } from '../../data/site';
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>業順官網後台</title>
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ darkModeEnabled }}>
      (function () {
        var t = 'light';
        if (darkModeEnabled) {
          try { t = localStorage.getItem('yeshun-theme'); } catch (e) {}
          if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <App client:only="preact" />
  </body>
</html>
