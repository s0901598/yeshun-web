---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { detailsEnabled, site } from '../data/site';
import { getFeaturedProjects, getDetails, getCompanies, getSettings } from '../lib/data';

const featured = await getFeaturedProjects(4);
const details = await getDetails();
const companies = await getCompanies();
const settings = await getSettings();
// 首頁背景輪播：後台「公司資料 → 首頁背景照片」上傳的照片；還沒上傳時用網站內建的工地照
const heroSlides = settings.heroImages.length
  ? settings.heroImages
  : ['/images/hero-site.webp', '/images/stage-site.webp', '/images/case-tower.webp', '/images/stage-frame.webp'].map((x) => u(x));
---
<Base>
  <!-- 主視覺 -->
  <section class="hero">
    <!-- 背景：照片輪流淡入淡出，同時緩慢推近、平移（像電影鏡頭） -->
    <div class="hero__bg" aria-hidden="true" data-hero>
      {heroSlides.map((src, i) => (
        <img class:list={['hero__slide', { 'is-active': i === 0 }]} src={src} alt="" style={`--x: ${[-2, 2, -2, 2][i % 4]}%; --y: ${[-1.5, -1.5, 1.5, 1.5][i % 4]}%`}
          fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
      ))}
      <span class="hero__shine"></span>
    </div>
    <div class="container hero__inner">
      <p class="eyebrow">INTERIOR DESIGN &amp; CONSTRUCTION</p>
      <h1 class="h-display hero__title">{site.slogan}</h1>
      <p class="lead">住宅、商業、辦公與公共空間的室內裝修設計與施工。每一道工序拍照記錄，讓業主看得見施工的每一步。</p>
      <div class="hero__actions">
        <a href={u('/projects')} class="btn btn--primary">看案例作品 <span class="arrow">→</span></a>
        <a href={u('/contact')} class="btn btn--ghost">預約諮詢</a>
      </div>
      <p class="hero__coord mono" aria-hidden="true">N 25.0912° / E 121.4666°　—　NEW TAIPEI, TAIWAN</p>
    </div>
  </section>

  <!-- 數據列（後台沒有填首頁數據時不顯示） -->
  {settings.stats.length > 0 && (
  <section class="stats">
    <div class="container">
      <ul class="stats__list reveal" style={`--n: ${settings.stats.length}`}>
        {settings.stats.map((s) => (
          <li class="stats__item">
            <p class="stats__value mono"><span data-count={s.value}>0</span><small>{s.suffix}</small></p>
            <p class="stats__label">{s.label}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}

  <!-- 服務項目：營造（業順）與裝修（耀三） -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">SERVICES</p>
        <h2 class="h-section">服務項目</h2>
        <p class="lead">營造工程由業順營造負責，室內裝修由耀三室內裝修承作，從結構到空間一次到位。</p>
      </div>
      <ul class="services">
        {[companies.yeshun, companies.yaosan].map((c) => (
          <li class="service corners reveal">
            <p class="service__field mono">{c.id === 'yeshun' ? 'CONSTRUCTION' : 'INTERIOR'}</p>
            <h3 class="service__title">{c.field}</h3>
            <p class="service__company">{c.shortName}</p>
            <p class="service__intro">{c.intro}</p>
            {c.services.length > 0 && (
              <ul class="service__list">{c.services.map((x) => <li>{x}</li>)}</ul>
            )}
            <a href={u('/about')} class="btn btn--ghost service__more">認識{c.shortName} <span class="arrow">→</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 精選案例 -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--split reveal">
        <div>
          <p class="eyebrow">FEATURED PROJECTS</p>
          <h2 class="h-section">精選案例</h2>
          <p class="lead">從老屋翻新到商業空間，每個案子都附上完整的施工過程。</p>
        </div>
        <a href={u('/projects')} class="btn btn--ghost">全部案例 <span class="arrow">→</span></a>
      </div>
      <ul class="featured">
        {featured.map((pj, i) => <li class="reveal"><ProjectCard project={pj} index={i} /></li>)}
      </ul>
    </div>
  </section>

  <!-- 注重的細節（目前隱藏，見 src/data/site.ts 的 detailsEnabled） -->
  {detailsEnabled && (
  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--split reveal">
        <div>
          <p class="eyebrow">OUR DETAILS</p>
          <h2 class="h-section">看不見的地方，才是重點</h2>
          <p class="lead">完工後被封起來的防水、管線與結構，決定了房子能住多久。</p>
        </div>
        <a href={u('/details')} class="btn btn--ghost">了解更多 <span class="arrow">→</span></a>
      </div>
      <ul class="details">
        {details.slice(0, 4).map((d) => (
          <li class="detail corners reveal">
            <p class="detail__code mono">{d.code}</p>
            <h3 class="detail__title">{d.title}</h3>
            <p class="detail__text">{d.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}

  <!-- 服務流程 -->
  <section class="section" id="process">
    <div class="container">
      <div class="section-head section-head--split reveal">
        <div>
          <p class="eyebrow">PROCESS</p>
          <h2 class="h-section">服務流程</h2>
          <p class="lead">從第一通電話到完工保固，五個步驟，每一步都清楚交代。</p>
        </div>
        <a href={u('/process')} class="btn btn--ghost">看完整流程 <span class="arrow">→</span></a>
      </div>
      <ProcessSteps />
    </div>
  </section>

  <ContactCTA />
</Base>

<style>
  /* 主視覺 */
  .hero {
    position: relative; min-height: 88svh; display: flex; align-items: flex-end;
    padding: calc(var(--header-h) + 48px) 0 56px; overflow: hidden; isolation: isolate;
  }
  @media (min-width: 768px) { .hero { min-height: 82vh; padding-bottom: 88px; } }
  .hero__bg { position: absolute; inset: 0; z-index: -2; }
  .hero__bg { overflow: hidden; background: var(--bg); }
  .hero__slide {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity 1.6s ease;
  }
  .hero__slide.is-active { opacity: 1; animation: hero-cam 9s ease-out both; }
  /* 四種鏡頭方向輪流用：推近＋往不同方向平移 */
  @keyframes hero-cam {
    from { transform: scale(1.02) translate(0, 0); }
    to { transform: scale(1.14) translate(var(--x), var(--y)); }
  }
  /* 遮罩只壓文字那一側（左、下），照片右半邊保留原本的顏色 */
  .hero__bg::after {
    content: ''; position: absolute; inset: 0; z-index: 2;
    background:
      linear-gradient(90deg, rgba(var(--bg-rgb), .82) 0%, rgba(var(--bg-rgb), .55) 42%, rgba(var(--bg-rgb), 0) 78%),
      linear-gradient(180deg, rgba(var(--bg-rgb), .35) 0%, rgba(var(--bg-rgb), 0) 30%, rgba(var(--bg-rgb), 0) 70%, var(--bg) 100%);
  }
  :global([data-theme='light']) .hero__bg::after {
    background:
      linear-gradient(90deg, rgba(var(--bg-rgb), .92) 0%, rgba(var(--bg-rgb), .7) 45%, rgba(var(--bg-rgb), 0) 80%),
      linear-gradient(180deg, rgba(var(--bg-rgb), .5) 0%, rgba(var(--bg-rgb), 0) 28%, rgba(var(--bg-rgb), 0) 70%, var(--bg) 100%);
  }
  /* 手機畫面窄、文字蓋滿整個寬度：遮罩改成上下漸層 */
  @media (max-width: 767px) {
    .hero__bg::after, :global([data-theme='light']) .hero__bg::after {
      background: linear-gradient(180deg, rgba(var(--bg-rgb), .3) 0%, rgba(var(--bg-rgb), .55) 40%, rgba(var(--bg-rgb), .82) 72%, var(--bg) 100%);
    }
  }
  /* 一道淡淡的金色光，緩慢掃過畫面 */
  .hero__shine {
    position: absolute; inset: -20% -40%; z-index: 1; pointer-events: none;
    background: linear-gradient(105deg, transparent 40%, rgba(215, 148, 45, .16) 50%, transparent 60%);
    animation: hero-shine 9s ease-in-out infinite;
  }
  @keyframes hero-shine { from { transform: translateX(-35%); } to { transform: translateX(35%); } }
  @media (prefers-reduced-motion: reduce) {
    .hero__slide { transition: none; }
    .hero__slide.is-active { animation: none; }
    .hero__shine { display: none; }
  }
  .hero__title { margin-top: 16px; max-width: 12em; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__coord { margin-top: 40px; font-size: 12px; color: var(--text-3); }
  @media (max-width: 767px) {
    .hero__actions { flex-direction: column; }
    .hero__actions .btn { width: 100%; }
  }

  /* 數據列 */
  .stats { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--bg-2); }
  .stats__list { display: grid; grid-template-columns: repeat(2, 1fr); }
  .stats__item { padding: 28px 8px; text-align: center; border-bottom: 1px solid var(--line); }
  .stats__item:nth-child(odd) { border-right: 1px solid var(--line); }
  .stats__item:nth-last-child(-n + 2) { border-bottom: 0; }
  .stats__value { font-size: clamp(32px, 5vw, 48px); color: var(--gold-text); line-height: 1.1; font-weight: 500; }
  .stats__value small { font-size: .45em; margin-left: 4px; color: var(--text-2); font-family: var(--font-sans); }
  .stats__label { font-size: 16px; color: var(--text-2); margin-top: 6px; }
  .stats__note { text-align: center; padding-bottom: 12px; }
  .stats__note:empty { display: none; }
  @media (min-width: 768px) {
    .stats__list { grid-template-columns: repeat(var(--n), 1fr); }
    .stats__item { border-bottom: 0; border-right: 1px solid var(--line); padding: 40px 8px; }
    .stats__item:last-child { border-right: 0; }
  }

  /* 精選案例：手機左右滑，平板 2 欄，電腦 4 欄 */
  .featured {
    display: grid; grid-auto-flow: column; grid-auto-columns: 80%; gap: 16px;
    overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px;
    margin: 0 calc(var(--gutter) * -1); padding-left: var(--gutter); padding-right: var(--gutter);
    scroll-padding-left: var(--gutter);
    scrollbar-width: none;
  }
  .featured::-webkit-scrollbar { display: none; }
  .featured > li { scroll-snap-align: start; }
  @media (min-width: 768px) {
    .featured { grid-auto-flow: row; grid-template-columns: repeat(2, 1fr); overflow: visible; margin: 0; padding: 0; gap: 24px; }
  }
  @media (min-width: 1200px) { .featured { grid-template-columns: repeat(4, 1fr); } }

  /* 服務項目 */
  .services { display: grid; gap: 20px; }
  .service { border: 1px solid var(--line); background: var(--surface); padding: 28px 24px; display: flex; flex-direction: column; }
  .service__field { font-size: 13px; color: var(--gold-text); }
  .service__title { font-size: clamp(26px, 3.4vw, 32px); margin-top: 6px; }
  .service__company { color: var(--gold-text); font-size: 17px; margin-top: 2px; }
  .service__intro { color: var(--text-2); margin-top: 14px; }
  .service__list { margin-top: 16px; border-top: 1px dashed var(--line); padding-top: 12px; display: grid; gap: 8px; }
  .service__list li { position: relative; padding-left: 22px; font-size: 17px; }
  .service__list li::before { content: ''; position: absolute; left: 2px; top: .7em; width: 8px; height: 8px; border: 1px solid var(--gold); transform: rotate(45deg); }
  .service__more { margin-top: 24px; align-self: flex-start; }
  @media (min-width: 768px) { .services { grid-template-columns: 1fr 1fr; gap: 24px; } .service { padding: 36px 32px; } }

  /* 細節 */
  .details { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .detail { background: rgba(var(--surface-rgb), .7); border: 1px solid var(--line); padding: 24px; }
  .detail__code { font-size: 13px; color: var(--gold-text); }
  .detail__title { font-size: 22px; margin: 6px 0 8px; }
  .detail__text { color: var(--text-2); font-size: 17px; }
  @media (min-width: 768px) { .details { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
  @media (min-width: 1200px) { .details { grid-template-columns: repeat(4, 1fr); } }
</style>

<script>
  // 首頁背景：每 6 秒換下一張；畫面不在前景（切到別的分頁）時暫停；使用者設定「減少動態效果」時不輪播
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const slides = hero ? [...hero.querySelectorAll<HTMLImageElement>('.hero__slide')] : [];
  if (slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let cur = 0;
    window.setInterval(() => {
      if (document.hidden) return;
      const next = (cur + 1) % slides.length;
      if (!slides[next].complete) { slides[next].loading = 'eager'; return; } // 下一張還沒載完就等下一輪
      slides[cur].classList.remove('is-active');
      slides[next].classList.add('is-active');
      cur = next;
    }, 6000);
    // 第一張出來後，先在背景載入其他張
    window.addEventListener('load', () => slides.forEach((img) => { img.loading = 'eager'; }));
  }
</script>
