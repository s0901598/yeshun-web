---
import Base from '../layouts/Base.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Todo from '../components/Todo.astro';
import { site } from '../data/site';

const values = [
  { en: 'TRANSPARENT', title: '透明', text: '報價逐項列明，施工過程拍照回報，業主隨時知道進度。' },
  { en: 'PRECISE', title: '精準', text: '丈量、放樣、工序安排都按部就班，減少返工與追加。' },
  { en: 'RESPONSIBLE', title: '負責', text: '完工不是結束，保固期內的問題由我們負責處理到好。' },
];
const services = ['住宅翻新與新屋裝修', '商業空間（店面、餐飲）', '辦公室規劃與裝修', '公共空間與社區公設', '水電、防水等專項工程', '老屋結構補強'];
---
<Base title="關於業順" description={site.intro}>
  <section class="page-hero">
    <div class="page-hero__bg" aria-hidden="true"><img src="/images/detail-plan.webp" alt="" /></div>
    <div class="blueprint blueprint-overlay" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow">ABOUT</p>
      <h1 class="h-display">關於業順</h1>
      <p class="lead">{site.intro}<Todo label="文案待確認" /></p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">COMPANY</p>
        <h2 class="h-section">{site.name}</h2>
        <dl class="profile">
          <div><dt class="mono">LICENSE</dt><dd>{site.license.value}<Todo show={site.license.todo} /></dd></div>
          <div><dt class="mono">QUALIFICATION</dt><dd>建築物室內裝修專業設計、施工廠商<br />符合建築物室內裝修管理辦法相關資格規定<Todo label="待確認" /></dd></div>
          <div><dt class="mono">ADDRESS</dt><dd>{site.address.value}<Todo show={site.address.todo} /></dd></div>
          <div><dt class="mono">EMAIL</dt><dd>{site.email.value}</dd></div>
        </dl>
      </div>
      <div class="photo corners reveal">
        <img src="/images/case-colonnade.webp" alt="業順營造施工空間示意" loading="lazy" />
        {site.showTodo && <span class="photo__tag mono">IMG / 待補公司照片</span>}
      </div>
    </div>
  </section>

  <section class="section section--alt blueprint--faint">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">VALUES</p>
        <h2 class="h-section">我們的做事方式</h2>
      </div>
      <ul class="values">
        {values.map((v, i) => (
          <li class="value reveal">
            <p class="value__no mono">0{i + 1} / {v.en}</p>
            <h3 class="value__title">{v.title}</h3>
            <p class="value__text">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">SERVICES</p>
        <h2 class="h-section">服務項目</h2>
        <p class="lead">從小坪數住宅到大型公共空間，設計與施工一次到位。</p>
      </div>
      <ul class="services reveal">
        {services.map((s, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
      </ul>
    </div>
  </section>

  <ContactCTA />
</Base>

<style>
  .split { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1200px) { .split { grid-template-columns: 1fr 1fr; gap: 80px; } }

  .profile { margin-top: 28px; border-top: 1px solid var(--line); }
  .profile div { display: grid; grid-template-columns: 1fr; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .profile dt { font-size: 12px; color: var(--gold); }
  .profile dd { color: var(--text-2); }
  @media (min-width: 768px) { .profile div { grid-template-columns: 160px 1fr; gap: 16px; } }

  .photo { aspect-ratio: 4 / 3; border: 1px solid var(--line); }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .photo__tag { position: absolute; left: 12px; bottom: 12px; font-size: 12px; background: rgba(26,26,26,.8); padding: 2px 8px; color: var(--gold); }

  .values { display: grid; gap: 16px; }
  .value { border: 1px solid var(--line); background: rgba(43,43,43,.7); padding: 28px 24px; }
  .value__no { font-size: 13px; color: var(--gold); }
  .value__title { font-size: 28px; margin: 8px 0; }
  .value__text { color: var(--text-2); }
  @media (min-width: 768px) { .values { grid-template-columns: repeat(3, 1fr); gap: 24px; } }

  .services { border-top: 1px solid var(--line); }
  .services li { display: flex; gap: 20px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--line); font-size: 19px; }
  .services span { font-size: 14px; color: var(--gold); }
  @media (min-width: 768px) { .services { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; } }
  @media (min-width: 1200px) { .services { grid-template-columns: 1fr; } }
</style>
