---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Todo from '../components/Todo.astro';
import { details } from '../data/site';
---
<Base title="我們注重的細節" description="防水、水電、隱蔽工程、工地整潔——業順營造在看不見的地方下功夫。">
  <section class="page-hero">
    <div class="page-hero__bg" aria-hidden="true"><img src={u('/images/stage-wall.webp')} alt="" /></div>
    <div class="blueprint blueprint-overlay" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow">OUR DETAILS</p>
      <h1 class="h-display">看不見的地方，<br />才是重點</h1>
      <p class="lead">裝修完成後，防水層、管線與結構都會被封起來。我們把這些工序當成最重要的部分，並且拍照記錄交給業主。<Todo label="文案待確認" /></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ol class="list">
        {details.map((d, i) => (
          <li class:list={['item', 'reveal', { 'item--flip': i % 2 === 1 }]}>
            <div class="item__media corners">
              <img src={u(d.image)} alt={d.title} loading="lazy" />
              <span class="item__code mono">{d.code}</span>
            </div>
            <div class="item__body">
              <p class="eyebrow">{d.code}</p>
              <h2 class="item__title">{d.title}</h2>
              <p class="item__summary">{d.summary}</p>
              <p class="item__text">{d.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ContactCTA />
</Base>

<style>
  .list { display: grid; gap: 64px; }
  .item { display: grid; gap: 24px; align-items: center; }
  .item__media { aspect-ratio: 16 / 10; border: 1px solid var(--line); }
  .item__media img { width: 100%; height: 100%; object-fit: cover; }
  .item__code {
    position: absolute; top: 12px; right: 12px; font-size: 13px;
    background: rgba(var(--bg-rgb), .8); color: var(--gold-text); padding: 2px 8px; border: 1px solid var(--line-strong);
  }
  .item__title { font-size: clamp(24px, 3.5vw, 34px); margin-top: 8px; }
  .item__summary { color: var(--gold-text); font-size: 19px; margin-top: 10px; }
  .item__text { color: var(--text-2); margin-top: 12px; }

  @media (min-width: 768px) {
    .list { gap: 88px; }
    .item { grid-template-columns: 1fr 1fr; gap: 40px; }
    .item--flip .item__media { order: 2; }
  }
  @media (min-width: 1200px) {
    .list { gap: 120px; }
    .item { grid-template-columns: 1.2fr 1fr; gap: 72px; }
    .item--flip { grid-template-columns: 1fr 1.2fr; }
  }
</style>
