---
// 關於我們：業順營造、耀三室內裝修各一頁，內容來自後台「公司資料」
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCompanies, getProjects, getSettings, type Company } from '../../lib/data';
import type { CompanyId } from '../../data/projects';

export async function getStaticPaths() {
  return [{ params: { company: 'yeshun' } }, { params: { company: 'yaosan' } }];
}

const id = Astro.params.company as CompanyId;
const companies = await getCompanies();
const c: Company = companies[id];
const other = companies[id === 'yeshun' ? 'yaosan' : 'yeshun'];
const settings = await getSettings();
const all = await getProjects();
const cases = all.filter((pj) => pj.company === id).slice(0, 6);

const values = [
  { en: 'TRANSPARENT', title: '透明', text: '報價逐項列明，施工過程拍照回報，業主隨時知道進度。' },
  { en: 'PRECISE', title: '精準', text: '丈量、放樣、工序安排都按部就班，減少返工與追加。' },
  { en: 'RESPONSIBLE', title: '負責', text: '完工不是結束，保固期內的問題由我們負責處理到好。' },
];
const heroImage = id === 'yeshun' ? '/images/hero-site.webp' : '/images/detail-plan.webp';
---
<Base title={c.shortName} description={c.intro}>
  <section class="page-hero">
    <div class="page-hero__bg" aria-hidden="true"><img src={u(heroImage)} alt="" /></div>
    <div class="container">
      <p class="eyebrow">ABOUT / {c.englishName}</p>
      <h1 class="h-display">{c.shortName}</h1>
      <p class="hero-field">{c.field}</p>
      {c.intro && <p class="lead">{c.intro}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">COMPANY</p>
        <h2 class="h-section">{c.name}</h2>
        <dl class="profile">
          <div><dt class="mono">FIELD</dt><dd>{c.field}</dd></div>
          {c.licenseNo && <div><dt class="mono">LICENSE</dt><dd>{c.licenseNo}</dd></div>}
          {settings.address && <div><dt class="mono">ADDRESS</dt><dd>{settings.address}</dd></div>}
          {settings.email && <div><dt class="mono">EMAIL</dt><dd><a href={settings.emailHref}>{settings.email}</a></dd></div>}
        </dl>
      </div>
      {c.licenseImage ? (
        <figure class="license corners reveal">
          <img src={c.licenseImage} alt={`${c.name} 登記證`} loading="lazy" />
          <figcaption class="mono">LICENSE / 登記證</figcaption>
        </figure>
      ) : (
        <div class="photo corners reveal">
          <img src={u(id === 'yeshun' ? '/images/stage-site.webp' : '/images/case-colonnade.webp')} alt="" loading="lazy" />
        </div>
      )}
    </div>
  </section>

  {c.services.length > 0 && (
    <section class="section section--alt">
      <div class="container split">
        <div class="reveal">
          <p class="eyebrow">SERVICES</p>
          <h2 class="h-section">服務項目</h2>
        </div>
        <ul class="services reveal">
          {c.services.map((s, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">VALUES</p>
        <h2 class="h-section">我們的做事方式</h2>
      </div>
      <ul class="values">
        {values.map((v, i) => (
          <li class="value reveal">
            <p class="value__no mono">0{i + 1} / {v.en}</p>
            <h3 class="value__title">{v.title}</h3>
            <p class="value__text">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {cases.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head section-head--split reveal">
          <div>
            <p class="eyebrow">PROJECTS</p>
            <h2 class="h-section">{c.shortName}的案例</h2>
          </div>
          <a href={u('/projects')} class="btn btn--ghost">全部案例 <span class="arrow">→</span></a>
        </div>
        <ul class="cases">
          {cases.map((pj) => <li class="reveal"><ProjectCard project={pj} index={all.indexOf(pj)} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="section other">
    <div class="container">
      <a href={u(`/about/${other.id}`)} class="other__link reveal">
        <span class="eyebrow">ALSO</span>
        <span class="other__title">{other.field}：{other.shortName}</span>
        <span class="other__go mono" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <ContactCTA />
</Base>

<style>
  .hero-field { color: var(--gold-text); font-size: clamp(18px, 2vw, 22px); margin-top: 6px; letter-spacing: .1em; }
  .split { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1200px) { .split { grid-template-columns: 1fr 1fr; gap: 80px; } }

  .profile { margin-top: 28px; border-top: 1px solid var(--line); }
  .profile div { display: grid; grid-template-columns: 1fr; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .profile dt { font-size: 12px; color: var(--gold-text); }
  .profile dd { color: var(--text-2); }
  .profile a:hover { color: var(--gold-text); }
  @media (min-width: 768px) { .profile div { grid-template-columns: 160px 1fr; gap: 16px; } }

  .photo, .license { aspect-ratio: 4 / 3; border: 1px solid var(--line); background: var(--surface); }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .license { display: grid; place-items: center; padding: 16px; aspect-ratio: auto; }
  .license img { max-height: 520px; width: auto; max-width: 100%; object-fit: contain; }
  .license figcaption { font-size: 12px; color: var(--gold-text); margin-top: 10px; }

  .values { display: grid; gap: 16px; }
  .value { border: 1px solid var(--line); background: rgba(var(--surface-rgb), .7); padding: 28px 24px; }
  .value__no { font-size: 13px; color: var(--gold-text); }
  .value__title { font-size: 28px; margin: 8px 0; }
  .value__text { color: var(--text-2); }
  @media (min-width: 768px) { .values { grid-template-columns: repeat(3, 1fr); gap: 24px; } }

  .services { border-top: 1px solid var(--line); }
  .services li { display: flex; gap: 20px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--line); font-size: 19px; }
  .services span { font-size: 14px; color: var(--gold-text); }

  .cases { display: grid; gap: 20px; }
  @media (min-width: 768px) { .cases { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
  @media (min-width: 1200px) { .cases { grid-template-columns: repeat(3, 1fr); } }

  .other { padding-top: 0; }
  .section--alt + .other { padding-top: 72px; }
  .other__link {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 6px 16px;
    border: 1px solid var(--line-strong); padding: 24px; transition: background-color .25s;
  }
  .other__link:hover { background: rgba(195, 162, 127, .08); }
  .other__link .eyebrow { grid-column: 1 / -1; }
  .other__title { font-size: clamp(20px, 3vw, 28px); font-weight: 700; }
  .other__go { font-size: 28px; color: var(--gold-text); }
</style>
