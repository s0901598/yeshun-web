---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import { categoryLabels } from '../data/projects';
import { getSettings } from '../lib/data';

const settings = await getSettings();
// 表單送到 Supabase 函式 submit-inquiry：存進後台「客戶需求」並寄 Email 通知
const submitUrl = `${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/submit-inquiry`;
const submitKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
// 後台沒填的聯絡方式不顯示
const channels = [
  { en: 'PHONE', label: '電話', value: settings.phone, href: settings.phoneHref },
  { en: 'LINE', label: 'LINE 官方帳號', value: settings.lineId, href: settings.lineHref },
  { en: 'EMAIL', label: 'Email', value: settings.email, href: settings.emailHref },
].filter((c) => c.value);
const banner = settings.pageBanner('contact');
---
<Base heroImage={banner} title="聯絡我們" description="營造工程、室內裝修諮詢與丈量預約，電話、LINE、Email 皆可聯絡。">
  <section class="page-hero">
    <div class="page-hero__bg" aria-hidden="true"><img src={banner} alt="" fetchpriority="high" /></div>
    <div class="container">
      <p class="eyebrow">CONTACT</p>
      <h1 class="h-display">聯絡我們</h1>
      <p class="lead">留下需求，我們會在一個工作天內與您聯繫，安排現場丈量與初步建議。<Todo label="回覆時效待確認" /></p>
    </div>
  </section>

  <section class="section">
    <div class="container layout">
      <!-- 聯絡方式 -->
      <div class="reveal">
        <ul class="channels">
          {channels.map((c) => (
            <li>
              <a href={c.href} class="channel corners" target={c.en === 'LINE' ? '_blank' : undefined} rel={c.en === 'LINE' ? 'noopener' : undefined}>
                <span class="channel__en mono">{c.en}</span>
                <span class="channel__label">{c.label}</span>
                <span class="channel__value">{c.value}</span>
                <span class="channel__arrow mono" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        {(settings.address || settings.hours) && (
          <dl class="info">
            {settings.address && <div><dt class="mono">ADDRESS</dt><dd>{settings.address}</dd></div>}
            {settings.hours && <div><dt class="mono">HOURS</dt><dd>{settings.hours}</dd></div>}
          </dl>
        )}
      </div>

      <!-- 需求表單：送出後存進後台「客戶需求」並寄 Email 通知 -->
      <form class="form reveal" data-form data-url={submitUrl} data-key={submitKey} novalidate>
        <p class="eyebrow">INQUIRY FORM</p>
        <h2 class="form__title">需求諮詢表單</h2>
        <!-- 機器人陷阱：畫面上看不到，人不會填 -->
        <label class="form__trap" aria-hidden="true">網站<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>

        <div class="row">
          <label class="field">
            <span>姓名 <em>*</em></span>
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label class="field">
            <span>電話 <em>*</em></span>
            <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
          </label>
        </div>
        <label class="field">
          <span>需求類型</span>
          <select name="service">
            <option>室內裝修（耀三室內裝修）</option>
            <option>營造工程（業順營造）</option>
            <option>還不確定</option>
          </select>
        </label>
        <div class="row">
          <label class="field">
            <span>空間類型</span>
            <select name="category">
              {Object.values(categoryLabels).map((c) => <option>{c.zh}</option>)}
              <option>其他</option>
            </select>
          </label>
          <label class="field">
            <span>坪數（約）</span>
            <input name="area" type="number" inputmode="numeric" min="0" />
          </label>
        </div>
        <label class="field">
          <span>案場地區</span>
          <input name="location" type="text" placeholder="例：新北市蘆洲區" />
        </label>
        <label class="field">
          <span>需求說明</span>
          <textarea name="message" rows="5" placeholder="例：30 年老公寓全室翻新，預計明年初入住"></textarea>
        </label>

        <button type="submit" class="btn btn--primary form__submit">送出需求 <span class="arrow">→</span></button>
        <p class="form__msg" data-form-msg role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  {settings.mapEmbed && (
    <section class="map">
      <iframe src={settings.mapEmbed} title="公司地圖位置" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
  )}
</Base>

<script>
  // 送出：檢查必填 → 送到後台（存檔＋寄 Email）→ 顯示結果。失敗時請客戶改用電話或 LINE
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const msg = form.querySelector<HTMLElement>('[data-form-msg]')!;
  const btn = form.querySelector<HTMLButtonElement>('.form__submit')!;
  const show = (text: string, state: 'error' | 'info' | 'ok') => { msg.textContent = text; msg.dataset.state = state; };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    if (!data.name?.trim() || !data.phone?.trim()) return show('請填寫姓名與電話。', 'error');
    if ((data.phone.match(/\d/g) ?? []).length < 6) return show('電話號碼好像不完整，請再確認一下。', 'error');
    btn.disabled = true; show('送出中…', 'info');
    try {
      const res = await fetch(form.dataset.url!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: form.dataset.key!, Authorization: `Bearer ${form.dataset.key}` },
        body: JSON.stringify(data),
      });
      if (res.status === 429) { show('您剛剛已經送出過了，我們收到後會儘快與您聯繫。', 'info'); return; }
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      show('已收到您的需求，我們會在一個工作天內與您聯繫，謝謝！', 'ok');
    } catch {
      show('送出時發生問題，請稍後再試，或直接用電話、LINE 與我們聯絡。', 'error');
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .layout { display: grid; gap: 48px; }
  @media (min-width: 1200px) { .layout { grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: start; } }

  .channels { display: grid; gap: 12px; }
  .channel {
    display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'en arrow' 'label arrow' 'value arrow';
    padding: 20px; border: 1px solid var(--line); background: var(--surface);
    transition: border-color .25s, background-color .25s;
  }
  .channel:hover { border-color: var(--line-strong); background: var(--surface-2); }
  .channel__en { grid-area: en; font-size: 12px; color: var(--gold-text); }
  .channel__label { grid-area: label; color: var(--text-2); font-size: 16px; }
  .channel__value { grid-area: value; font-size: 22px; font-weight: 500; word-break: break-all; }
  .channel__arrow { grid-area: arrow; align-self: center; color: var(--gold-text); font-size: 20px; }
  @media (min-width: 768px) and (max-width: 1199px) { .channels { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); } }

  .info { margin-top: 28px; border-top: 1px solid var(--line); }
  .info div { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .info dt { font-size: 12px; color: var(--gold-text); }
  .info dd { color: var(--text-2); }

  .form { border: 1px solid var(--line); background: var(--bg-2); padding: 24px 20px; display: grid; gap: 18px; }
  @media (min-width: 768px) { .form { padding: 40px; } }
  .form__title { font-size: 26px; margin-top: -6px; }
  .row { display: grid; gap: 18px; }
  @media (min-width: 768px) { .row { grid-template-columns: 1fr 1fr; } }
  .field { display: grid; gap: 6px; font-size: 16px; color: var(--text-2); }
  .field em { color: var(--amber-text); font-style: normal; }
  .field input, .field select, .field textarea {
    width: 100%; min-height: 48px; padding: 10px 14px;
    background: var(--bg); color: var(--text); border: 1px solid var(--line);
    font: inherit; font-size: 17px; border-radius: 0;
    transition: border-color .2s;
  }
  .field textarea { resize: vertical; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--gold-text); }
  .form__submit { width: 100%; }
  .form__msg { font-size: 16px; min-height: 1.5em; }
  .form__msg[data-state='error'] { color: var(--danger); }
  .form__msg[data-state='info'] { color: var(--gold-text); }
  .form__msg[data-state='ok'] { color: var(--gold-text); font-weight: 700; }
  .form__trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form__submit:disabled { opacity: .6; cursor: wait; }

  .map { border-top: 1px solid var(--line); }
  .map iframe { display: block; width: 100%; height: 320px; border: 0; }
  @media (min-width: 768px) { .map iframe { height: 420px; } }
</style>
