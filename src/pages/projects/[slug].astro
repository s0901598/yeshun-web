---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import '../../styles/project-detail.css';
import ContactCTA from '../../components/ContactCTA.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { categoryLabels, statusLabels, type Project } from '../../data/projects';
import { getCompanies, getProjects } from '../../lib/data';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((project) => ({ params: { slug: project.slug }, props: { project, all } }));
}

interface Props { project: Project; all: Project[] }
const { project, all } = Astro.props;
const cat = categoryLabels[project.category];
const company = (await getCompanies())[project.company];
const fmt = (d: string) => d.replaceAll('-', '.');

// 主圖：封面 + 最後一個階段（通常是完工）的照片
const lastStage = project.stages.at(-1);
const gallery = [
  { url: project.cover, caption: project.title },
  ...(lastStage?.photos ?? []).filter((ph) => ph.url !== project.cover),
];
const related = all.filter((pj) => pj.slug !== project.slug && pj.category === project.category).slice(0, 3);
const others = related.length ? related : all.filter((pj) => pj.slug !== project.slug).slice(0, 3);
---
<Base title={project.title} description={project.summary}>
<div class="pd">
  <section class="intro">
    <div class="container">
      <a href={u('/projects')} class="back mono">← ALL PROJECTS</a>
      <p class="eyebrow">{cat.en} · {statusLabels[project.status]}</p>
      <h1 class="title">{project.title}</h1>

      <dl class="specs mono">
        <div><dt>CATEGORY</dt><dd>{cat.zh}</dd></div>
        <div><dt>LOCATION</dt><dd>{project.location}</dd></div>
        <div><dt>AREA</dt><dd>{project.areaPing} 坪</dd></div>
        <div><dt>DURATION</dt><dd>{project.durationDays} 天</dd></div>
        <div><dt>BUILDER</dt><dd>承作：{company.shortName}</dd></div>
        <div><dt>STATUS</dt><dd class:list={[project.status]}>{statusLabels[project.status]}</dd></div>
      </dl>
    </div>
  </section>

  <!-- 主圖 -->
  <section class="gallery-wrap">
    <div class="container">
      <div class="gallery" style={`--thumbs: ${Math.max(Math.min(gallery.length - 1, 3), 1)}`}>
        {gallery.map((ph, i) => (
          <button type="button" class:list={['gallery__item', 'corners', { 'gallery__item--main': i === 0 }]} data-lightbox={ph.url} data-caption={ph.caption}>
            <img src={ph.url} alt={ph.caption} loading={i === 0 ? 'eager' : 'lazy'} />
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- 案例說明 -->
  <section class="section about">
    <div class="container about__grid">
      <div class="reveal">
        <p class="eyebrow">OVERVIEW</p>
        <h2 class="h-section">案例說明</h2>
        <p class="about__text">{project.summary}</p>
      </div>
      {project.highlights.length > 0 && (
        <div class="reveal">
          <p class="eyebrow">KEY POINTS</p>
          <ul class="highlights">
            {project.highlights.map((h, i) => (
              <li><span class="mono">{String(i + 1).padStart(2, '0')}</span>{h}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- 施工進度時間軸 -->
  {project.stages.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">CONSTRUCTION LOG</p>
          <h2 class="h-section">施工進度</h2>
          <p class="lead">每個階段的現場照片，記錄完工後看不見的工序。</p>
        </div>

        <ol class="timeline">
          {project.stages.map((stage, i) => {
            const isCurrent = project.status === 'in_progress' && i === project.stages.length - 1;
            return (
              <li class:list={['stage', 'reveal', { 'is-current': isCurrent }]}>
                <span class="stage__node" aria-hidden="true"></span>
                <div class="stage__head">
                  <p class="stage__date mono">{fmt(stage.date)}</p>
                  <h3 class="stage__name">
                    <span class="mono">STEP {String(i + 1).padStart(2, '0')}</span>
                    {stage.name}
                    {isCurrent && <em class="stage__live">進行中</em>}
                  </h3>
                  <p class="stage__note">{stage.note}</p>
                </div>
                {stage.photos.length > 0 && (
                  <ul class="stage__photos">
                    {stage.photos.map((ph) => (
                      <li>
                        <button type="button" data-lightbox={ph.url} data-caption={`${stage.name}｜${ph.caption}`}>
                          <img src={ph.url} alt={ph.caption} loading="lazy" />
                        </button>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )}

  <!-- 其他案例 -->
  {others.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">MORE PROJECTS</p>
          <h2 class="h-section">其他案例</h2>
        </div>
        <ul class="others">
          {others.map((pj) =><li class="reveal"><ProjectCard project={pj} index={all.indexOf(pj)} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <ContactCTA />

  <!-- 看大圖 -->
  <dialog class="lightbox" data-lightbox-dialog aria-label="檢視照片">
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="關閉">✕</button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="上一張">‹</button>
    <figure>
      <img data-lightbox-img alt="" />
      <figcaption class="mono" data-lightbox-cap></figcaption>
    </figure>
    <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="下一張">›</button>
  </dialog>
</div>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]')!;
  const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
  const cap = dialog.querySelector<HTMLElement>('[data-lightbox-cap]')!;
  const triggers = [...document.querySelectorAll<HTMLElement>('[data-lightbox]')];
  let current = 0;

  const show = (i: number) => {
    current = (i + triggers.length) % triggers.length;
    const t = triggers[current];
    img.src = t.dataset.lightbox!;
    img.alt = t.dataset.caption ?? '';
    cap.textContent = `${String(current + 1).padStart(2, '0')} / ${String(triggers.length).padStart(2, '0')}　${t.dataset.caption ?? ''}`;
  };

  triggers.forEach((t, i) => t.addEventListener('click', () => { show(i); dialog.showModal(); }));
  dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // 手機左右滑動切換
  let startX = 0;
  dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
</script>

