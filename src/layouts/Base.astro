---
import { u } from '../lib/url';
import '../styles/global.css';
import { darkModeEnabled, nav } from '../data/site';
import { getCompanies, getSettings } from '../lib/data';

interface Props { title?: string; description?: string; noindex?: boolean }
const companies = await getCompanies();
const settings = await getSettings();
const { yeshun, yaosan } = companies;
const { title, description = yeshun.intro, noindex = false } = Astro.props;
const pageTitle = title ? `${title}｜${yeshun.name}` : `${yeshun.name}｜營造工程・室內裝修`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === u(href) || path.startsWith(u(href) + '/');
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f7f5f1" data-theme-color />
    <script is:inline define:vars={{ darkModeEnabled }}>
      // 在畫面出現前決定主題，避免閃一下：預設淺色；訪客按過切換鈕選了深色才用深色
      (function () {
        var t = 'light';
        if (darkModeEnabled) {
          try { t = localStorage.getItem('theme'); } catch (e) {}
          if (t !== 'dark') t = 'light';
        }
        document.documentElement.dataset.theme = t;
        document.querySelector('[data-theme-color]').content = t === 'light' ? '#f7f5f1' : '#1a1a1a';
      })();
    </script>
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="header" data-header>
      <div class="container header__inner">
        <a href={u('/')} class="brand" aria-label={`${yeshun.shortName}、${yaosan.shortName} 首頁`}>
          <img src={u('/images/logo-mark.png')} alt="" width="48" height="35" />
          <span class="brand__text">
            <span class="brand__zh">{yeshun.shortName}</span><span class="brand__bar brand__bar--zh" aria-hidden="true">｜</span><span class="brand__zh">{yaosan.shortName}</span>
            <span class="brand__en">{yeshun.englishName}</span><span class="brand__bar" aria-hidden="true">｜</span><span class="brand__en">{yaosan.englishName}</span>
          </span>
        </a>

        <nav class="nav" id="site-nav" aria-label="主選單" data-nav>
          <ul class="nav__list">
            {nav.map((item) => item.children ? (
              <li class="nav__group" data-sub>
                <button type="button" class:list={['nav__link', 'nav__toggle', { 'is-active': isActive(item.href) }]}
                  aria-expanded="false" aria-controls={`sub-${item.en}`} data-sub-toggle>
                  <span class="nav__en mono">{item.en}</span>
                  <span>{item.label}</span>
                  <span class="nav__chev" aria-hidden="true"></span>
                </button>
                <ul class="nav__sub" id={`sub-${item.en}`}>
                  {item.children.map((c) => (
                    <li><a href={u(c.href)} class:list={['nav__sublink', { 'is-active': isActive(c.href) }]}>{c.label}</a></li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={u(item.href)} class:list={['nav__link', { 'is-active': isActive(item.href) }]}>
                  <span class="nav__en mono">{item.en}</span>
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
          <a href={u('/contact')} class="btn btn--primary nav__cta">預約諮詢</a>
        </nav>

        {darkModeEnabled && <button class="theme-btn" type="button" data-theme-btn aria-label="切換淺色／深色模式" title="切換淺色／深色模式">
          <svg class="theme-btn__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
          <svg class="theme-btn__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
        </button>}

        <button class:list={['menu-btn', { 'menu-btn--solo': !darkModeEnabled }]} aria-label="開啟選單" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__grid">
        <div class="footer__brand">
          <img src={u('/images/logo-mark.png')} alt="" width="64" height="46" />
          {[yeshun, yaosan].map((c) => (
            <div class="footer__company">
              <p class="footer__name">{c.name}</p>
              <p class="footer__field">{c.field}</p>
              {c.licenseNo && <p class="footer__license mono">{c.licenseNo}</p>}
            </div>
          ))}
        </div>
        {(settings.phone || settings.lineId || settings.email) && (
          <div>
            <p class="footer__label mono">CONTACT</p>
            <ul class="footer__list">
              {settings.phone && <li><a href={settings.phoneHref}>電話　{settings.phone}</a></li>}
              {settings.lineId && <li><a href={settings.lineHref} target="_blank" rel="noopener">LINE　{settings.lineId}</a></li>}
              {settings.email && <li><a href={settings.emailHref}>Email　{settings.email}</a></li>}
            </ul>
          </div>
        )}
        {(settings.address || settings.hours) && (
          <div>
            <p class="footer__label mono">ADDRESS</p>
            <ul class="footer__list">
              {settings.address && <li>{settings.address}</li>}
              {settings.hours && <li>{settings.hours}</li>}
            </ul>
          </div>
        )}
        <div>
          <p class="footer__label mono">SITEMAP</p>
          <ul class="footer__list footer__list--cols">
            {nav.flatMap((item) => item.children ?? [item]).map((item) => <li><a href={u(item.href)}>{item.label}</a></li>)}
            <li><a href={u('/contact')}>聯絡我們</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__bottom">
        <div class="container mono">© {new Date().getFullYear()} {yeshun.englishName} × {yaosan.englishName}</div>
      </div>
    </footer>

    <!-- 手機版固定聯絡列 -->
    <div class="quickbar" aria-label="快速聯絡" style={`grid-template-columns: ${'1fr '.repeat([settings.phone, settings.lineId].filter(Boolean).length)}1.3fr`}>
      {settings.phone && <a href={settings.phoneHref}><span class="mono">TEL</span>撥打電話</a>}
      {settings.lineId && <a href={settings.lineHref} target="_blank" rel="noopener"><span class="mono">LINE</span>加 LINE</a>}
      <a href={u('/contact')} class="quickbar__main"><span class="mono">BOOK</span>預約諮詢</a>
    </div>

    <script>
      import { darkModeEnabled } from '../data/site';
      // 淺色／深色切換：預設淺色，記住使用者選擇
      const root = document.documentElement;
      const themeColor = document.querySelector<HTMLMetaElement>('[data-theme-color]');
      const applyTheme = (t: string) => {
        root.dataset.theme = t;
        if (themeColor) themeColor.content = t === 'light' ? '#f7f5f1' : '#1a1a1a';
      };
      document.querySelector('[data-theme-btn]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        applyTheme(next);
        try { localStorage.setItem('theme', next); } catch {}
      });
      // 按「上一頁」時瀏覽器會拿出暫存的舊畫面，顏色可能是換頁前的；回來時、或在別的分頁改過時，重新套用記住的選擇
      const savedTheme = () => {
        let t: string | null = null;
        try { t = localStorage.getItem('theme'); } catch {}
        return darkModeEnabled && t === 'dark' ? 'dark' : 'light';
      };
      window.addEventListener('pageshow', () => applyTheme(savedTheme()));
      window.addEventListener('storage', (e) => { if (e.key === 'theme') applyTheme(savedTheme()); });

      // Logo 文字：同一欄的中文和英文撐成一樣寬（平均加字距），兩行頭尾與「｜」對齊
      const fitBrand = () => {
        const cells = [...document.querySelectorAll<HTMLElement>('.brand__zh, .brand__en')];
        cells.forEach((el) => { el.style.letterSpacing = ''; el.style.marginRight = ''; el.style.textAlignLast = 'auto'; });
        const cols = [[cells[0], cells[2]], [cells[1], cells[3]]];
        for (const col of cols) {
          if (col.some((el) => !el)) continue;
          const widths = col.map((el) => el.getBoundingClientRect().width);
          const target = Math.max(...widths);
          col.forEach((el, i) => {
            const n = [...(el.textContent ?? '')].length;
            if (n < 2 || target - widths[i] < 0.5) return;
            const ls = (target - widths[i]) / (n - 1);
            el.style.letterSpacing = `${ls}px`;
            el.style.marginRight = `${-ls}px`; // 最後一個字後面的字距不算
          });
        }
      };
      fitBrand();
      document.fonts?.ready.then(fitBrand);
      let fitTimer = 0;
      window.addEventListener('resize', () => { clearTimeout(fitTimer); fitTimer = window.setTimeout(fitBrand, 100); });

      // 捲動後頁首加底色
      const header = document.querySelector('[data-header]');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // 手機／平板選單
      const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
      const navEl = document.querySelector('[data-nav]');
      const setMenu = (open: boolean) => {
        btn?.setAttribute('aria-expanded', String(open));
        btn?.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
        navEl?.classList.toggle('is-open', open);
        document.body.classList.toggle('menu-open', open);
      };
      btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
      navEl?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
      window.matchMedia('(min-width: 1200px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

      // 「關於我們」子選單：手機在選單裡展開；電腦是下拉選單，點外面會關閉
      const groups = document.querySelectorAll<HTMLElement>('[data-sub]');
      const closeGroups = (except?: Element) => groups.forEach((g) => {
        if (g === except) return;
        g.classList.remove('is-open');
        g.querySelector('[data-sub-toggle]')?.setAttribute('aria-expanded', 'false');
      });
      groups.forEach((g) => {
        const toggle = g.querySelector<HTMLButtonElement>('[data-sub-toggle]')!;
        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = !g.classList.contains('is-open');
          closeGroups(g);
          g.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
        });
      });
      document.addEventListener('click', (e) => {
        if (window.matchMedia('(min-width: 1200px)').matches && !(e.target as Element).closest('[data-sub]')) closeGroups();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeGroups(); });

      // 進場動畫與數字跳動
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        if (reduce) { el.textContent = String(target); return; }
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min((now - start) / 1400, 1);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          el.classList.add('is-in');
          el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
          io.unobserve(el);
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal, [data-stagger]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  /* 頁首 */
  .header {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition: border-color .3s;
  }
  /* 毛玻璃底色放在獨立的底層。不能直接加在 .header 上：
     iPhone Safari 會把 backdrop-filter 元素當成 fixed 子元素的範圍，選單會被截在頁首高度內 */
  .header::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    transition: background-color .3s;
  }
  .header.is-scrolled, :global(body.menu-open) .header { border-bottom-color: var(--line); }
  .header.is-scrolled::before, :global(body.menu-open) .header::before {
    background: rgba(var(--bg-rgb), 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  :global(body.menu-open) .header::before { background: var(--bg); }
  .header__inner { height: 100%; display: flex; align-items: center; gap: 8px; }
  .brand { display: flex; align-items: center; gap: 12px; position: relative; z-index: 2; }
  .brand img { width: 40px; height: auto; }
  /* 兩行（中文／英文）左右兩端與中間的「｜」都對齊：三欄格線；字距由下方程式平均撐開到一樣寬（沒有程式時用左右對齊備援） */
  .brand__text { display: grid; grid-template-columns: auto auto auto; align-items: center; line-height: 1.3; --zh: 17px; --en: 9px; }
  .brand__zh, .brand__en { justify-self: start; white-space: nowrap; text-align: justify; text-align-last: justify; }
  .brand__zh { font-size: var(--zh); font-weight: 700; }
  .brand__en { font-size: var(--en); color: var(--gold-text); margin-top: 1px; }
  .brand__bar { font-size: var(--en); color: var(--gold-text); text-align: center; padding: 0 .5em; }
  .brand__bar--zh { font-size: var(--zh); font-weight: 400; padding: 0 .1em; }
  /* 手機：頁首還有主題鈕和選單鈕，Logo 文字跟著螢幕寬度縮放 */
  @media (max-width: 767px) {
    .brand { gap: 8px; } .brand img { width: 34px; }
    .brand__text { --zh: clamp(12px, 3.75vw, 17px); --en: calc(var(--zh) * .53); }
  }
  @media (max-width: 349px) { .brand { gap: 6px; } .brand img { width: 28px; } .brand__text { --zh: 11.5px; } }
  @media (min-width: 768px) { .brand__text { --zh: 18px; --en: 9.5px; } }
  @media (min-width: 1200px) { .brand__text { --zh: 20px; --en: 10.5px; } }

  /* 選單：手機與平板為全螢幕抽屜 */
  .nav {
    position: fixed; inset: var(--header-h) 0 0 0;
    background: var(--bg);
    padding: 24px var(--gutter) calc(40px + env(safe-area-inset-bottom));
    display: flex; flex-direction: column; gap: 32px;
    overscroll-behavior: contain;
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity .25s, transform .25s, visibility .25s;
    overflow-y: auto;
  }
  .nav.is-open { opacity: 1; visibility: visible; transform: none; }
  .nav__list { display: flex; flex-direction: column; }
  .nav__link {
    display: flex; align-items: baseline; gap: 16px;
    padding: 18px 0; border-bottom: 1px solid var(--line);
    font-size: 24px; font-weight: 500;
  }
  .nav__en { font-size: 13px; color: var(--gold-text); width: 96px; }
  .nav__link.is-active { color: var(--gold-text); }
  .nav__toggle { width: 100%; text-align: left; cursor: pointer; }
  .nav__chev {
    margin-left: auto; width: 10px; height: 10px; flex: none; align-self: center;
    border-right: 1.5px solid var(--gold); border-bottom: 1.5px solid var(--gold);
    transform: rotate(45deg) translateY(-3px); transition: transform .25s;
  }
  .nav__group.is-open .nav__chev { transform: rotate(-135deg) translateY(-3px); }
  /* 手機、平板：子選單在抽屜裡展開 */
  .nav__sub { display: none; padding: 4px 0 12px 112px; border-bottom: 1px solid var(--line); }
  .nav__group.is-open .nav__sub { display: block; }
  .nav__group.is-open .nav__toggle { border-bottom-color: transparent; }
  .nav__sublink { display: block; padding: 12px 0; font-size: 20px; color: var(--text-2); }
  .nav__sublink.is-active, .nav__sublink:hover { color: var(--gold-text); }
  .nav__cta { width: 100%; }

  /* 主題切換按鈕 */
  .theme-btn {
    width: 44px; height: 44px; display: grid; place-items: center; flex: none;
    margin-left: auto; margin-right: -4px; position: relative; z-index: 2;
    color: var(--gold-text); border-radius: 50%;
    transition: background-color .2s;
  }
  .theme-btn:hover { background: rgba(195, 162, 127, .14); }
  .theme-btn svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .theme-btn__moon { display: none; }
  :global([data-theme='light']) .theme-btn__sun { display: none; }
  :global([data-theme='light']) .theme-btn__moon { display: block; }

  .menu-btn--solo { margin-left: auto; margin-right: -4px; }
  .menu-btn { width: 44px; height: 44px; display: grid; place-content: center; gap: 6px; position: relative; z-index: 2; }
  .menu-btn span { display: block; width: 24px; height: 1.5px; background: var(--text); transition: transform .25s, opacity .25s; }
  .menu-btn[aria-expanded='true'] span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  @media (min-width: 768px) {
    .nav__link { font-size: 28px; padding: 22px 0; }
    .nav__cta { width: auto; align-self: flex-start; }
    .brand img { width: 48px; }
  }

  /* 電腦版：橫向選單 */
  @media (min-width: 1200px) {
    .menu-btn { display: none; }
    .theme-btn { order: 3; margin-left: 0; margin-right: -8px; }
    .nav {
      position: static; opacity: 1; visibility: visible; transform: none;
      background: none; padding: 0; overflow: visible;
      flex-direction: row; align-items: center; gap: 36px; margin-left: auto; margin-right: 16px;
    }
    .nav__list { flex-direction: row; gap: 32px; }
    .nav__link {
      flex-direction: column; gap: 0; align-items: flex-start;
      padding: 0; border: 0; font-size: 17px; position: relative;
    }
    .nav__en { font-size: 11px; width: auto; }
    .nav__link::after {
      content: ''; position: absolute; left: 0; bottom: -6px; height: 1px; width: 0;
      background: var(--gold); transition: width .3s;
    }
    .nav__link:hover::after, .nav__link.is-active::after { width: 100%; }
    /* 電腦版：下拉選單 */
    .nav__group { position: relative; }
    .nav__toggle { width: auto; flex-direction: column; padding-right: 18px; }
    .nav__chev { position: absolute; right: 0; bottom: 8px; width: 7px; height: 7px; margin: 0; }
    .nav__sub {
      position: absolute; top: calc(100% + 18px); left: -18px; min-width: 200px;
      padding: 8px 0; border: 1px solid var(--line-strong); background: var(--bg);
      box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
    }
    .nav__group:hover .nav__sub, .nav__group:focus-within .nav__sub { display: block; }
    .nav__group::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 20px; } /* 滑鼠移到下拉選單途中不會關掉 */
    .nav__sublink { font-size: 16px; padding: 10px 18px; }
    .nav__cta { min-height: 46px; padding: 0 22px; }
  }

  /* 頁尾 */
  .footer { border-top: 1px solid var(--line); padding-top: 56px; margin-bottom: 64px; }
  .footer__grid { display: grid; grid-template-columns: 1fr; gap: 36px; padding-bottom: 48px; }
  .footer__brand img { width: 56px; margin-bottom: 12px; }
  .footer__company + .footer__company { margin-top: 14px; }
  .footer__field { font-size: 14px; color: var(--gold-text); }
  .footer__name { font-size: 20px; font-weight: 700; letter-spacing: 0.08em; }
  .footer__license { font-size: 14px; color: var(--text-3); margin-top: 4px; }
  .footer__label { font-size: 13px; color: var(--gold-text); margin-bottom: 12px; }
  .footer__list { color: var(--text-2); font-size: 17px; display: grid; gap: 8px; }
  .footer__list a:hover { color: var(--gold-text); }
  .footer__list--cols { grid-template-columns: 1fr 1fr; }
  .footer__bottom { border-top: 1px solid var(--line); padding: 20px 0; font-size: 13px; color: var(--text-3); }
  @media (min-width: 768px) {
    .footer__grid { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
  @media (min-width: 1200px) {
    .footer { margin-bottom: 0; }
    .footer__grid { grid-template-columns: 1.3fr 1fr 1fr 1fr; }
  }

  /* 手機／平板固定聯絡列 */
  .quickbar {
    position: fixed; inset: auto 0 0 0; z-index: 90;
    display: grid; /* 欄數依有填的聯絡方式決定（寫在元素的 style 上） */
    background: rgba(var(--bg2-rgb), 0.96);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid var(--line-strong);
