---
// 進站 Loading：每個分頁第一次打開官網、或按重新整理時出現（在官網裡換頁、上一頁不出現）。
// 方案 A「藍圖繪製」：業順 Logo 的線條像建築師畫圖一樣一筆一筆畫出（咖啡金），畫線的筆尖帶一點光。
// 每次約 3 秒畫完（網路慢也不超過 3 秒）。
// 從首頁網址進來、或在任何一頁按重新整理時，100% 後回到預設的「案例作品」頁最上方。
import { u } from '../lib/url';

// Logo 線條（依 public/images/logo-mark.png 重畫，座標 240×173）
const left = 'M20 28 L118 6 L118 150 L20 118 Z';
const right = 'M118 6 L215 24 L215 120 L118 150 Z';
const base = 'M2 122 L20 118 L118 150 L215 120 L238 122 L120 172 Z';
const yTopL = (x: number) => 28 - (22 / 98) * (x - 20), yBotL = (x: number) => 118 + (32 / 98) * (x - 20);
const yTopR = (x: number) => 6 + (18 / 97) * (x - 118), yBotR = (x: number) => 150 - (30 / 97) * (x - 118);
const stripes = [
  ...[34, 47, 60, 73, 86, 100].map((x) => `M${x} ${(yTopL(x) + 4).toFixed(1)} L${x} ${(yBotL(x) - 4).toFixed(1)}`),
  ...[134, 147, 160, 173, 186, 200].map((x) => `M${x} ${(yTopR(x) + 4).toFixed(1)} L${x} ${(yBotR(x) - 4).toFixed(1)}`),
];
const projectsUrl = u('/projects/');
const homePath = u('/');
---
<div class="loader" id="site-loader" role="status" aria-live="polite" aria-label="網站載入中">
  <div class="loader__inner">
    <svg class="loader__logo" id="loader-svg" viewBox="-6 -6 252 186" aria-hidden="true">
      <defs>
        <filter id="loader-glow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="1.4" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <!-- 依序畫出：外框三塊 → 條紋 -->
      <g class="loader__lines">
        <path d={left} data-draw /><path d={right} data-draw /><path d={base} data-draw />
        {stripes.map((d) => <path class="loader__stripe" d={d} data-draw />)}
      </g>
    </svg>
    <p class="loader__pct mono"><span id="loader-pct">000</span>%</p>
  </div>
</div>

<script is:inline define:vars={{ projectsUrl, homePath }}>
  (function () {
    var root = document.documentElement;
    if (!root.classList.contains('is-loading')) return;
    var el = document.getElementById('site-loader');
    var svg = document.getElementById('loader-svg');
    var pct = document.getElementById('loader-pct');
    var paths = Array.prototype.slice.call(el.querySelectorAll('[data-draw]'));
    var lens = paths.map(function (p) { var l = p.getTotalLength(); p.style.strokeDasharray = l; p.style.strokeDashoffset = l; return l; });
    var isHome = location.pathname === homePath || location.pathname === homePath + 'index.html';
    var onProjects = location.pathname === projectsUrl || location.pathname === projectsUrl + 'index.html';
    // 首頁網址、或重新整理（不在案例作品頁時）→ 載完跳到案例作品
    var goProjects = isHome || (window.__yeshunReload && !onProjects);
    var start = performance.now(), MIN = 2800, MAX = 3000, shown = 0, done = false;
    var ease = function (t) { return 1 - Math.pow(1 - t, 3); };
    var clamp = function (v) { return Math.max(0, Math.min(1, v)); };
    // 實際載入進度：頁面上的圖片＋整頁 load；要跳到案例作品時也先在背景載入那一頁
    var real = function () {
      var imgs = Array.prototype.filter.call(document.images, function (i) { return i.loading !== 'lazy'; });
      var ok = imgs.filter(function (i) { return i.complete; }).length;
      var p = imgs.length ? ok / imgs.length : 1;
      if (document.readyState !== 'complete') p = Math.min(p, 0.9);
      if (goProjects && !window.__projectsReady) p = Math.min(p, 0.95);
      return p;
    };
    if (goProjects) fetch(projectsUrl, { credentials: 'same-origin' }).then(function (r) { return r.text(); })
      .finally(function () { window.__projectsReady = true; });
    // 依進度畫圖：每條線輪流畫出，正在畫的那條帶光，100% 時整個 Logo 亮一下
    var draw = function (p) {
      var n = paths.length;
      paths.forEach(function (path, i) {
        var s = clamp((p * 1.15 - i / n * 0.75) / 0.4);
        path.style.strokeDashoffset = lens[i] * (1 - ease(s));
        path.classList.toggle('is-drawing', s > 0 && s < 1);
      });
      svg.classList.toggle('is-complete', p >= 1);
      pct.textContent = ('00' + Math.round(p * 100)).slice(-3);
    };
    var finish = function () {
      if (done) return; done = true;
      try { sessionStorage.setItem('yeshun-loaded', '1'); } catch (e) {}
      if (!/(?:^|;)yeshun-loaded=1/.test(window.name)) window.name += ';yeshun-loaded=1';
      if (goProjects) { location.replace(projectsUrl); return; }
      if (window.__yeshunReload) window.scrollTo(0, 0);
      el.classList.add('is-done');
      setTimeout(function () { root.classList.remove('is-loading'); el.remove(); }, 500);
    };
    var tick = function (now) {
      var t = now - start;
      // 顯示的進度跟著時間走（約 3 秒畫完），網路還沒載完時會稍微等一下，但 3 秒一定完成
      var target = t >= MAX ? 1 : Math.min(real(), t / MIN);
      shown += (target - shown) * 0.25;
      if ((target === 1 && shown > 0.995) || t >= MAX) shown = 1;
      draw(shown);
      if (shown >= 1) setTimeout(finish, 150); else requestAnimationFrame(tick);
    };
    draw(0);
    requestAnimationFrame(tick);
  })();
</script>

<style>
  /* 線條、尺寸標註、百分比都用咖啡金（業主 2026-10-13 選定） */
  .loader { display: none; --loader-gold: #94703a; }
  :global(html.is-loading) .loader {
    position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center;
    background: var(--bg); transition: opacity .5s ease;
  }
  :global(html.is-loading) body { overflow: hidden; }
  .loader.is-done { opacity: 0; }
  .loader__inner { display: grid; justify-items: center; gap: 14px; }
  .loader__logo { width: min(52vw, 230px); height: auto; overflow: visible; transition: filter .4s ease; }
  .loader__logo.is-complete { filter: drop-shadow(0 0 10px rgba(148, 112, 58, .65)); }
  /* 線條加粗，正在畫的那一筆帶光，看起來更鮮明 */
  .loader__lines { fill: none; stroke: var(--loader-gold); stroke-width: 2.6; stroke-linejoin: round; stroke-linecap: round; }
  .loader__stripe { stroke-width: 1.8; }
  .loader__lines .is-drawing { filter: url(#loader-glow); }
  .loader__pct { font-size: 18px; font-weight: 500; letter-spacing: .24em; color: var(--loader-gold); }
</style>
