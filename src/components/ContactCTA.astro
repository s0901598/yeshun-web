---
// 全站頁尾前的結語＋預約諮詢按鈕。結語在後台「公司資料 → 公司介紹頁 → 結語」修改
import { u } from '../lib/url';
import { getSettings } from '../lib/data';
import { richHtml } from '../lib/rich';

const { closingQuote, closingText } = await getSettings();
---
<section class="cta section">
  <div class="container cta__inner reveal">
    <p class="eyebrow">OUR PROMISE</p>
    {closingQuote && <blockquote class="cta__quote" set:html={`「${richHtml(closingQuote)}」`} />}
    {closingText && <p class="cta__text" set:html={richHtml(closingText)} />}
    <a href={u('/contact')} class="btn btn--primary cta__btn">預約諮詢 <span class="arrow">→</span></a>
  </div>
</section>

<style>
  .cta { border-top: 1px solid var(--line); background-color: var(--bg-2); text-align: center; }
  .cta__inner { display: flex; flex-direction: column; align-items: center; }
  .cta__quote {
    max-width: 22em; margin: 8px auto 0;
    font-size: clamp(24px, 3.4vw, 38px); font-weight: 700; line-height: 1.5; color: var(--text);
  }
  .cta__text { max-width: 36em; margin: 20px auto 0; font-size: clamp(18px, 1.8vw, 20px); color: var(--text-2); }
  .cta__btn { margin-top: 36px; }
  @media (max-width: 767px) { .cta__btn { width: 100%; } }
</style>
