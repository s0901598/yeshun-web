---
// 首頁精簡版流程：捲到這裡時，連接線畫出來，步驟依序出現
import { getProcessSteps } from '../lib/data';

const processSteps = await getProcessSteps();
---
<ol class="steps" data-stagger>
  {processSteps.map((step, i) => (
    <li class="step" style={`--i: ${i}`}>
      <span class="step__no mono">{step.no}</span>
      <span class="step__node" aria-hidden="true"></span>
      <h3 class="step__title">{step.title}</h3>
      <p class="step__desc">{step.desc}</p>
    </li>
  ))}
</ol>

<style>
  /* 每一步出現的間隔 */
  .steps { --gap: 0.45s; position: relative; display: grid; padding-left: 32px; }

  /* 連接線：手機直向、電腦橫向，從 0 畫到滿 */
  .steps::before {
    content: ''; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 1px;
    background: linear-gradient(var(--gold), var(--line));
    transform: scaleY(0); transform-origin: top;
    transition: transform calc(var(--gap) * 5) linear .2s;
  }
  .steps:global(.is-in)::before { transform: none; }

  .step {
    position: relative; padding: 0 0 36px;
    opacity: 0; transform: translateY(18px);
    transition: opacity .6s ease, transform .6s ease;
    transition-delay: calc(var(--i) * var(--gap) + .3s);
  }
  .step:last-child { padding-bottom: 0; }
  .steps:global(.is-in) .step { opacity: 1; transform: none; }

  /* 節點：線畫到時亮起來 */
  .step__node {
    position: absolute; left: -32px; top: 6px; width: 15px; height: 15px;
    border: 1px solid var(--line-strong); background: var(--bg); transform: rotate(45deg);
    transition: border-color .4s, box-shadow .4s;
    transition-delay: inherit;
  }
  .step__node::after {
    content: ''; position: absolute; inset: 3px; background: var(--gold);
    transform: scale(0); transition: transform .4s cubic-bezier(.3, 1.6, .5, 1);
    transition-delay: inherit;
  }
  .steps:global(.is-in) .step__node { border-color: var(--gold); box-shadow: 0 0 14px rgba(195, 162, 127, .55); }
  .steps:global(.is-in) .step__node::after { transform: scale(1); }

  .step__no { font-size: 14px; color: var(--gold-text); }
  .step__title { font-size: 22px; margin-top: 2px; }
  .step__desc { color: var(--text-2); font-size: 17px; margin-top: 6px; }

  @media (min-width: 768px) {
    .steps { grid-template-columns: repeat(2, 1fr); column-gap: 40px; row-gap: 8px; padding-left: 0; }
    .steps::before { display: none; }
    .step { padding: 24px 0 24px 32px; border-left: 1px solid var(--line); }
    .step__node { left: -8px; top: 30px; }
  }

  @media (min-width: 1200px) {
    .steps { grid-template-columns: repeat(5, 1fr); column-gap: 28px; }
    .steps::before {
      display: block; left: 0; right: 0; top: 52px; bottom: auto; width: auto; height: 1px;
      background: linear-gradient(90deg, var(--gold), var(--line));
      transform: scaleX(0); transform-origin: left;
    }
    .step { border-left: 0; padding: 0; }
    .step__node { position: relative; display: block; left: 0; top: 0; margin: 18px 0 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .steps::before, .step, .step__node, .step__node::after { transition: none !important; }
    .steps::before { transform: none; }
    .step { opacity: 1; transform: none; }
    .step__node::after { transform: scale(1); }
  }
</style>
